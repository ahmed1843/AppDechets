{
  "expo": {
    "name": "SAMA GOX",
    "slug": "smart-city-waste",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#166534"
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.smartwaste.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0D1117"
      },
      "config": {
        "googleMaps": {
          "apiKey": "VOTRE_CLE_GOOGLE_MAPS"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Localisation pour suivre le camion poubelle."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#166534",
          "defaultChannel": "truck-alerts"
        }
      ],
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "3f90957e-7f1a-447b-91ad-6bca8eda1276"
      }
    },
    "owner": "ahmed2510"
  }
}