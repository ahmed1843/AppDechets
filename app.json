
// app.json — version corrigée et fusionnée
{
  "expo": {
    "name": "SmartWaste",
    "slug": "smart-city-waste",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D1117"
    },
    "web": {                          // ← AJOUTÉ ICI
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.smartwaste.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D1117"
      },
      "config": {
        "googleMaps": {
          "apiKey": "VOTRE_CLE_GOOGLE_MAPS"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Localisation pour suivre le camion poubelle."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3f90957e-7f1a-447b-91ad-6bca8eda1276"
      }
    },
    "owner": "ahmed2510"
  }
}
